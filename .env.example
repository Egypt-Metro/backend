# Copy to .env (local) or paste these as environment variables in your host's
# dashboard (Koyeb / Render / Fly). Values here are safe placeholders.

# ------------------------------------------------------------------ core
ENVIRONMENT=dev                     # dev | prod  (prod turns on SSL redirect, secure cookies, requires REDIS_URL only if you set one)
DEBUG=True                          # MUST be False in production
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-another-long-random-string
BASE_URL=http://localhost:8000      # public base URL of this backend

# ------------------------------------------------------------------ database
# Local docker-compose sets this automatically. For a hosted deploy use the
# connection string from Neon / Supabase (include ?sslmode=require).
DATABASE_URL=postgres://metro:metro@localhost:5432/metro

# ------------------------------------------------------------------ hosting / CORS
# Comma-separated. Add your deployed domain(s) here; localhost is always allowed.
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# ------------------------------------------------------------------ websockets (optional)
# Leave unset for a single web instance (in-memory channel layer, no Redis).
# Set to an Upstash/other Redis URL only when running multiple workers/instances.
# REDIS_URL=rediss://default:password@host:6379

# ------------------------------------------------------------------ email (optional; features degrade gracefully without it)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ------------------------------------------------------------------ server
PORT=8000
WEB_CONCURRENCY=1                   # keep at 1 unless REDIS_URL is set
